# =============================================================================
# KHANNAX ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your real credentials.
# DO NOT COMMIT THE REAL .env FILE TO GIT.
# =============================================================================

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Storage Bucket
SUPABASE_STORAGE_BUCKET=documents

# Security & CORS (Production)
FORCE_HTTPS=false
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis Caching & Distributed Rate Limiting (Production)
REDIS_URL=redis://localhost:6379/0

